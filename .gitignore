# ========================================
*.tmp
*.bak
*.swp
*.swo
*~
*.backup
*.mojibake-backup-*

# ========================================
# 日志文件
# ========================================
*.log
compile.log
package.log
setup.log*
startup_smoke_*.log

# ========================================
# 大型模型文件（不提交到 GitHub）
